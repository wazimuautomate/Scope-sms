<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Permission set — owned by Phase 1 (BUILD-PLAN.md).

      One permission must NEVER appear in this file: SEND_SMS. All outbound
      messages go through the SCOPE SMS HTTP gateway using the registered
      sender ID, never SmsManager (CLAUDE.md constraint 3). ArchitectureGuardTest
      fails the build if it reappears.
    -->

    <!-- Ingestion. RECEIVE_SMS is what actually delivers SMS_RECEIVED to the
         manifest receiver in Phase 2. READ_SMS is requested alongside it (same
         permission group, so they are granted together anyway) and is what any
         later "re-read a message we missed" recovery path would need. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <!-- Dual-SIM identification: without this, SubscriptionManager returns an
         empty list and the agent cannot tell us which SIM receives M-Pesa —
         which is the filter that stops their personal payments triggering
         customer replies (CLAUDE.md constraint 4). -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- Lets us show each SIM's own MSISDN in the picker.
         DEVIATION from BUILD-PLAN Phase 1's listed permission set, deliberately:
         the plan asks for "display number if available", and from API 33
         SubscriptionInfo.getNumber() requires READ_PHONE_NUMBERS specifically —
         READ_PHONE_STATE alone returns blank. Both of the agent's SIMs may well
         be Safaricom, in which case the carrier name disambiguates nothing and
         the number is the only thing that does. Optional by design: the picker
         degrades to slot + carrier if this is denied. See memory.md. -->
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />

    <!-- Outbound replies reach the gateway over HTTP (CLAUDE.md constraint 2).
         Not a runtime permission — install-time only, no prompt. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Phase 5b's queue worker uses this to hold jobs until connectivity
         returns rather than dropping them. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- API 33+. Runtime-prompted only on 33+; harmless on 30-32, where
         notifications need no grant. Used for send-failure alerts — a failed
         reply is money-adjacent and the agent must notice it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Normal permission; it does not prompt. It only makes the system accept
         ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS, which is what actually
         asks the agent. Play restricts apps that declare this, which does not
         apply here: distribution is direct-install APK (CLAUDE.md constraint 8),
         and this app is already outside Play's SMS policy regardless. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Phase 9. Normal permission; no prompt.
         NOT here to restart ingestion — a manifest receiver already survives
         reboot on its own once the app has been launched. It's here because a
         reboot is when the things ingestion silently depends on change: SIMs get
         re-read, and OEM battery managers re-apply their restrictions. This lets
         BootCompletedReceiver check the app still works and say so if it doesn't. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Phase 9. Lets OemSettingsLauncher call PackageManager.resolveActivity()
         against OEM system apps (Phone Master, MIUI Security, ...) to find out
         which autostart screen actually exists on this device.
         Required because targetSdk 36 is well past API 30's package-visibility
         filtering: without this, resolveActivity() returns null for every OEM
         component and the guidance screen would silently degrade to
         instructions-only on every device — including the ones where the
         deep link works fine.
         QUERY_ALL_PACKAGES is deliberately NOT used: it's the blunt instrument
         Play restricts, and we only need to see a handful of known components,
         which <queries> below names explicitly. -->
    <queries>
        <!-- Transsion (Tecno / Infinix / itel) — the primary target market.
             Three packages, not one: Phone Master hosts autostart on Tecno and
             Infinix, HiManager is a *separate app* that hosts itel's version,
             and himgr ships standalone on some Infinix builds. Declaring a
             package makes all of its activities visible, which covers the
             action-based lookups too. -->
        <package android:name="com.transsion.phonemaster" />
        <package android:name="com.transsion.phonemanager" />
        <package android:name="com.cyin.himgr" />
        <!-- Xiaomi (MIUI / HyperOS). -->
        <package android:name="com.miui.securitycenter" />
        <!-- Oppo / Realme (ColorOS). -->
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.oppo.safe" />
        <!-- Vivo (Funtouch / OriginOS). -->
        <package android:name="com.vivo.permissionmanager" />
        <package android:name="com.iqoo.secure" />
        <!-- Huawei (EMUI). -->
        <package android:name="com.huawei.systemmanager" />
        <!-- Samsung (One UI). -->
        <package android:name="com.samsung.android.lool" />
    </queries>

    <!-- Telephony is required, not optional: an SMS-ingestion app is useless on
         a device without it. Declared explicitly so the requirement is visible
         rather than implied by the permissions above. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="true" />

    <application
        android:name=".ScopeSmsApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScopeSms">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ScopeSms">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phase 2 registers the SMS_RECEIVED receiver here. Not declared in
             Phase 1: naming a class that doesn't exist yet fails the build. -->

        <!--
          Phase 9 — post-reboot health check.

          exported="true" is required: the sender is the OS.

          Deliberately NO android:permission here, unlike the SMS receiver above.
          There is no BROADCAST_BOOT_COMPLETED permission in the platform — SMS
          has BROADCAST_SMS, boot has no equivalent. Naming one anyway would not
          be harmless: an android:permission that no caller can hold blocks
          *every* sender including the system, so the receiver would simply never
          fire and the health check would silently never run. That is the exact
          class of invisible failure this phase exists to catch.

          What actually protects it: BOOT_COMPLETED is a protected broadcast in
          AOSP's framework manifest, so only the system can send it — the
          guarantee is in the platform, not in this file. QUICKBOOT_POWERON is a
          non-AOSP OEM action and is NOT protected, so any app could send it;
          the worst that buys an attacker is one extra health check, and
          BootCompletedReceiver validates the action either way.
        -->
        <receiver
            android:name=".reliability.BootCompletedReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
