    <string name="onb_perm_title">Let Scope SMS read your M-Pesa messages</string>
    <string name="onb_perm_body">It reads incoming messages on this phone to spot till payments. Nothing is uploaded anywhere — reading happens on the phone itself.</string>
    <string name="onb_perm_grant">Grant permissions</string>
