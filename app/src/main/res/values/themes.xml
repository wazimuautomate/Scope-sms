<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose owns all in-app theming (see ui/theme/Theme.kt). This XML theme
      only styles the window before the first frame composes, so it stays
      deliberately thin. Parenting to the platform theme rather than
      Theme.MaterialComponents keeps the Material Views library out of the
      dependency graph entirely — nothing in this app draws a View.
    -->
    <style name="Theme.ScopeSms" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
