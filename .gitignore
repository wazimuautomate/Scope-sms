# ---------------------------------------------------------------------------
# Secrets — NEVER commit. See CLAUDE.md constraint 7.
# The SCOPE SMS gateway API key and sender ID are entered by the agent at
# runtime and stored encrypted on-device. They must never reach this repo.
# ---------------------------------------------------------------------------
local.properties
secrets.properties
keystore.properties
*.jks
*.keystore
*.p12
*.pem
!debug.keystore
.env
.env.*
!.env.example
google-services.json
api-keys.properties

